{
  "name": "despliegue",

  "image": "mcr.microsoft.com/devcontainers/php:8.4",

  // Instala Node.js LTS y npm de forma reproducible al construir el contenedor.
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    }
  },

  // Ajuste de seguridad necesario para ejecutar las herramientas en este entorno.
  "runArgs": ["--security-opt", "seccomp=unconfined"],

  "containerEnv": {
    "XDEBUG_MODE": "off"
  },

  // Publica Laravel (8000) y Vite (5173) en el ordenador anfitrión.
  "forwardPorts": [8000, 5173],

  "portsAttributes": {
    "8000": {
      "label": "Backend Laravel"
    },
    "5173": {
      "label": "Frontend Vue"
    }
  },

  "postCreateCommand": "sudo git config --system --add safe.directory '*'",

  "customizations": {
    "vscode": {
      // Extensiones que se instalarán automáticamente dentro del contenedor.
      "extensions": [
        "laravel.vscode-laravel",
        "bmewburn.vscode-intelephense-client",
        "humao.rest-client",
        "Vue.volar",
        "openai.chatgpt"
      ]
    }
  }
}
