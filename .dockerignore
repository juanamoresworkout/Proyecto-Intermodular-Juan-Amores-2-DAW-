# UD3.2.h: Excluye del contexto de Docker archivos locales o regenerables.

# Control de versiones
.git/
.gitignore

# Entorno virtual local
piapp-env/

# Caché y bytecode de Python
__pycache__/
*.py[cod]

# Base de datos local
db.sqlite3
db.sqlite3-journal

# Archivos recopilados o subidos
/static/
/media/

# Variables privadas
.env
.env.*

# Editores y herramientas
.vscode/
.idea/
.pytest_cache/
.ruff_cache/